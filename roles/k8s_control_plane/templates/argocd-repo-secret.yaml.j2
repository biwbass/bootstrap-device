# Managed by roles/k8s_control_plane/tasks/argocd.yml — do not hand-edit.
#
# Credential template that lets Argo CD clone the private repositories under
# {{ argocd_repo_creds_url }} over https as a dedicated, read-only GitHub App.
# Argo CD mints its own short-lived installation tokens from the App key, so
# nothing here needs rotating on a schedule.
apiVersion: v1
kind: Secret
metadata:
  name: {{ argocd_repo_creds_secret_name }}
  namespace: {{ argocd_namespace }}
  labels:
    # repo-creds, not repository: a credential TEMPLATE matched by URL prefix,
    # so every repoURL under {{ argocd_repo_creds_url }} uses it without a
    # Secret of its own. A `repository` Secret whose url matches a repoURL
    # exactly still wins over this one.
    argocd.argoproj.io/secret-type: repo-creds
    # REQUIRED as well. Argo CD's settings informer only watches ConfigMaps and
    # Secrets carrying this label; without it the Secret exists as far as
    # kubectl is concerned while Argo CD cannot see it at all, and every
    # Application fails to sync with an authentication error that looks like a
    # bad credential rather than a missing label.
    app.kubernetes.io/part-of: argocd
type: Opaque
stringData:
  type: git
  url: {{ argocd_repo_creds_url }}
  githubAppID: "{{ vault_argocd_github_app_id }}"
  githubAppInstallationID: "{{ vault_argocd_github_app_installation_id }}"
  githubAppPrivateKey: |
{{ vault_argocd_github_app_private_key | indent(4, true) }}
